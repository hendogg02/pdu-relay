# Copy this file to .env and fill in real values.
# NEVER commit .env to git or paste its contents anywhere.

# Port this relay listens on, for both the PDU Ctrl.grid DashBoard panel and
# the web UI (http://<this-host>:<port>/). This is the only setting that
# lives here - the UniFi controller host, credentials, and everything else
# are configured live through the web UI (Setup, then Connection Settings)
# and stored in config.json, which is created automatically on first run.
PDU_RELAY_PORT=8090
